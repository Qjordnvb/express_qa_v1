            "type": "getByRole",
            "value": "list",
            "options": {
              "name": "- list  :"
            }
          }
        ],
        "waitBefore": "visible"
      }
    ]
  },
  "testSteps": [
    {
      "page": "EcommercePage",
      "action": "navigate",
      "params": []
    },
    {
      "page": "EcommercePage",
      "action": "fillEmailInput",
      "params": [
        "jordanvillarreal1994@gmail.com"
      ]
    },
    {
      "page": "EcommercePage",
      "action": "fillPasswordInput",
      "params": [
        "12345678"
      ]
    },
    {
      "page": "EcommercePage",
      "action": "clickLoginButton",
      "params": []
    },
    {
