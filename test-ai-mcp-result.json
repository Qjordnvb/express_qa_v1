          "click"
        ],
        "selectors": [
          {
            "type": "getByRole",
            "value": "checkbox",
            "options": {
              "name": "In stock"
            }
          }
        ],
        "waitBefore": "visible",
        "validateAfter": true
      },
      {
        "name": "searchResultsList",
