        "waitBefore": "visible",
        "validateAfter": true
      },
      {
        "name": "searchButton",
        "elementType": "button",
        "actions": [
          "click"
        ],
        "selectors": [
          {
            "type": "getByRole",
            "value": "button",
            "options": {
              "name": "Search"
            }
          }
        ],
        "waitBefore": "enabled",
        "validateAfter": true
      },
      {
        "name": "inStockCheckbox",
        "elementType": "checkbox",
