# Express QA v1 - Environment Variables Template
# Copia este archivo a .env y configura tus valores

# Google Gemini API Key (REQUERIDO)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Browser preference (default: chromium)
BROWSER=chromium

# Optional: OpenAI API Key (not used in current configuration)
# OPENAI_API_KEY=your_openai_key_here

# Optional: Anthropic Claude API Key (not used in current configuration)
# ANTHROPIC_API_KEY=your_anthropic_key_here
