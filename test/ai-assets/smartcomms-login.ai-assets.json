{
  "pageObject": {
    "className": "SmartCommsLoginPage",
    "locators": [
      {
        "name": "loginAbInbevButton",
        "elementType": "button",
        "actions": [
          "click"
        ],
        "selectors": [
          {
            "type": "getByRole",
            "value": "button",
            "options": {
              "name": "Ingresa por Ab-Inbev"
            }
          },
          {
            "type": "css",
            "value": "button:has-text('Ingresa por Ab-Inbev')"
          }
        ]
      }
    ]
  },
  "additionalPageObjects": [
    {
      "className": "SmartCommsEmailAndPasswordPage",
      "locators": [
        {
          "name": "emailInput",
          "elementType": "input",
          "actions": [
            "fill"
          ],
          "selectors": [
            {
              "type": "getByPlaceholder",
              "value": "Correo electrónico"
            },
            {
              "type": "css",
              "value": "input[type='email']"
            }
          ]
        },
        {
          "name": "passwordInput",
          "elementType": "input",
          "actions": [
            "fill"
          ],
          "selectors": [
            {
              "type": "getByPlaceholder",
              "value": "Contraseña"
            },
            {
              "type": "css",
              "value": "input[type='password']"
            }
          ]
        },
        {
          "name": "submitButton",
          "elementType": "button",
          "actions": [
            "click"
          ],
          "selectors": [
            {
              "type": "getByRole",
              "value": "button",
              "options": {
                "name": "Iniciar sesión"
              }
            },
            {
              "type": "css",
              "value": "button:has-text('Iniciar sesión')"
            }
          ]
        }
      ]
    },
    {
      "className": "SmartCommsDashboardPage",
      "locators": [
        {
          "name": "dashboardTitle",
          "elementType": "text",
          "actions": [
            "waitForVisible"
          ],
          "selectors": [
            {
              "type": "getByText",
              "value": "Dashboard"
            }
          ]
        }
      ]
    }
  ],
  "testSteps": [
    {
      "page": "SmartCommsLoginPage",
      "action": "navigate",
      "params": [
        "/login"
      ]
    },
    {
      "page": "SmartCommsLoginPage",
      "action": "clickLoginAbInbevButton",
      "params": []
    },
    {
      "page": "SmartCommsEmailAndPasswordPage",
      "action": "fillEmailInput",
      "params": [
        "example@example.com"
      ]
    },
    {
      "page": "SmartCommsEmailAndPasswordPage",
      "action": "fillPasswordInput",
      "params": [
        "xxxxxxxxxxxxx***$"
      ]
    },
    {
      "page": "SmartCommsEmailAndPasswordPage",
      "action": "clickSubmitButton",
      "params": []
    },
    {
      "page": "SmartCommsDashboardPage",
      "action": "waitForDashboardTitleVisible",
      "params": [],
      "assert": {
        "type": "textVisible",
        "expected": "Dashboard"
      }
    }
  ]
}
