{
  "name": "express_qa_hybrid",
  "version": "2.0.0",
  "description": "AI-powered test automation framework with stable Claude Code MCP integration",
  "main": "index.js",
  "scripts": {
    "postinstall": "npx playwright install",
    "start": "ts-node start-hybrid.ts",
    "start:claude": "echo 'Run: claude --resume (then use start script)'",
    "generate:pom": "ts-node tools/generate-pom.ts",
    "generate:spec": "ts-node tools/generate-spec.ts",
    "orchestrate": "ts-node start-hybrid.ts",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:basic": "ts-node test-basic-functionality.ts",
    "test:mcp": "ts-node test-mcp-integration.ts",
    "dev": "ts-node api/server.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "playwright",
    "ai",
    "testing",
    "automation",
    "mcp",
    "claude-code"
  ],
  "author": "Jordan Villareal",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@chroma-core/default-embed": "^0.1.8",
    "@google/generative-ai": "^0.24.1",
    "chromadb": "^3.0.9",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "openai": "^5.3.0",
    "socket.io": "^4.7.5",
    "yaml": "^2.8.0"
  }
}
