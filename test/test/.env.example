# 🚀 Express QA Hybrid Environment Configuration
# Copy this file to .env and configure your settings

# 🤖 AI Provider API Keys (configure at least one)
# Get your keys from the respective provider websites

# Google Gemini (Primary recommended)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Anthropic Claude (Secondary option)
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# OpenAI GPT (Tertiary option)
OPENAI_API_KEY=your_openai_gpt_api_key_here

# 🎯 Target Application Configuration
# Configure this to point to your application under test
BASE_URL=https://www.google.com

# 🧠 AI & Learning Configuration
# AI provider selection (auto, gemini, claude, openai)
AI_PROVIDER=auto

# Enable learning system (true/false)
ENABLE_LEARNING=true

# Learning confidence threshold (0.0 to 1.0)
LEARNING_THRESHOLD=0.7

# 📊 ChromaDB Configuration (for vector memory)
# Local ChromaDB instance
CHROMA_HOST=localhost
CHROMA_PORT=8001

# 🖥️ Browser Configuration
# Browser type (chromium, firefox, webkit)
BROWSER_TYPE=chromium

# Headless mode (true for CI/CD, false for debugging)
HEADLESS=true

# Browser timeout (milliseconds)
BROWSER_TIMEOUT=30000

# 📸 Screenshot & Debug Configuration
# Screenshot quality (0-100)
SCREENSHOT_QUALITY=90

# Enable screenshots on failure
SCREENSHOT_ON_FAILURE=true

# Enable video recording on failure
VIDEO_ON_FAILURE=true

# 🔧 Test Execution Configuration
# Test timeout (milliseconds)
TEST_TIMEOUT=60000

# Assertion timeout (milliseconds)
ASSERTION_TIMEOUT=10000

# Number of retries on CI
CI_RETRIES=2

# 📊 Reporting Configuration
# Output directory for reports
REPORTS_PATH=./test-results

# Enable HTML reports
ENABLE_HTML_REPORTS=true

# Enable JSON reports (required for AI analysis)
ENABLE_JSON_REPORTS=true

# 🌐 Cloud Configuration (for future SaaS deployment)
# Cloud provider (aws, gcp, azure)
CLOUD_PROVIDER=

# Cloud region
CLOUD_REGION=

# API endpoint (for cloud deployment)
API_ENDPOINT=

# 🔒 Security Configuration
# Enable strict SSL verification
STRICT_SSL=false

# User agent override
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# 📝 Logging Configuration
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed MCP logging
MCP_DEBUG=false

# Enable AI conversation logging
AI_DEBUG=false

# 🎛️ Advanced Configuration
# Claude Code integration mode
CLAUDE_CODE_MODE=hybrid

# Enable native MCP tools
ENABLE_NATIVE_MCP=true

# MCP tool timeout (milliseconds)
MCP_TIMEOUT=30000

# 🚀 Development vs Production
# Environment (development, staging, production)
NODE_ENV=development

# Enable development features
DEV_MODE=true

# Enable hot reload for API
HOT_RELOAD=true